# Every URL below is reached server-side only, over the Docker network
# services_default: the browser never talks to these tools directly.

# PostgreSQL: dedicated database and user for this site (see README, "Base de données").
# Local dev through an SSH tunnel: postgres://status:PASSWORD@localhost:5432/status
DATABASE_URL=postgres://status:CHANGE_ME@postgres:5432/status

# Uptime Kuma: public status page read through its JSON API (no token needed).
# The slug is the one in the status page URL: /status/<slug>.
UPTIME_KUMA_URL=http://uptime-kuma:3001
UPTIME_KUMA_STATUS_SLUG=infra
# Automatic incidents: Uptime Kuma's "Webhook" notification posts to
# http://status:3000/api/webhooks/uptime-kuma with the header
#   Authorization: Bearer <this secret>
# Generate it with: openssl rand -hex 32. Empty = endpoint disabled.
UPTIME_KUMA_WEBHOOK_SECRET=

# Prometheus HTTP API (PromQL). Availability bands need Prometheus to scrape
# Uptime Kuma's /metrics (see README); CPU/RAM/disk come from Node Exporter.
PROMETHEUS_URL=http://prometheus:9090
# Optional extra label matchers for Node Exporter series, when Prometheus
# scrapes more than one host. Example: instance="node-exporter:9100"
# PROMETHEUS_NODE_SELECTOR=
